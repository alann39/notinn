{
  "name": "notinn-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npx vite",
    "build": "npm run build:client && npm run build:ssr && npm run prerender",
    "build:client": "tsc --noEmit && npx vite build",
    "build:ssr": "npx vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "serve:dist": "node scripts/serve-dist.mjs --host 127.0.0.1 --port 4173",
    "preview": "npm run serve:dist",
    "lint": "npx eslint .",
    "build:test": "cross-env VITE_DEPLOYMENT_ENV=production VITE_SITE_URL=http://127.0.0.1:4173 VITE_SUPABASE_URL=https://example.invalid VITE_SUPABASE_ANON_KEY=test-publishable-key npm run build",
    "test:browser": "npm run build:test && playwright test",
    "test:browser:headed": "npm run build:test && playwright test --headed"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@daypicker/react": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@radix-ui/react-icons": "^1.3.2",
    "@supabase/supabase-js": "2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "dompurify": "^3.4.15",
    "framer-motion": "13.4.4",
    "gsap": "^3.15.0",
    "lucide-react": "^0.511.0",
    "marked": "^18.0.14",
    "motion": "^13.4.4",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "tailwind-merge": "^3.3.0",
    "tailwind-variants": "^0.3.1",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.28.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.1.8",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@types/tus-js-client": "^1.8.0",
    "@vitejs/plugin-react": "^4.5.2",
    "cross-env": "10.1.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.1.0",
    "sanitize-html": "2.17.7",
    "tailwindcss": "^4.1.8",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^6.3.5"
  }
}
