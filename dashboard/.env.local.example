# Supabase project URL (public, not a secret)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable anon key (public, not a secret)
# DO NOT use the service_role key here — it must never be in browser code
VITE_SUPABASE_ANON_KEY=eyJ...

# Public site origin for canonical SEO URLs. Absolute origin only, no path.
VITE_SITE_URL=http://127.0.0.1:4173

# Public deployment contract used by generated robots/sitemap metadata.
VITE_DEPLOYMENT_ENV=development
