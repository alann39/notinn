{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite-env.d.ts"],
  // Cornell note (cornell-*) = WIP yang diarsipkan: tidak dilanjutkan, tidak dihapus.
  // Dikecualikan dari typecheck supaya `npm run build:client` hijau lagi. File-nya
  // tetap ada di disk dan tidak disentuh. Mau lanjut Cornell lagi? Hapus blok exclude
  // ini, atau `git checkout dashboard/tsconfig.json`.
  "exclude": [
    "src/components/dashboard/cornell-note-convert.ts",
    "src/components/dashboard/cornell-note-draft.ts",
    "src/components/dashboard/cornell-note-editor.tsx",
    "src/components/dashboard/cornell-note-link.ts",
    "src/components/dashboard/cornell-note-persist.ts",
    "src/components/dashboard/cornell-note-view.tsx",
    "src/components/dashboard/cornell-seamless.tsx",
    "src/app/test-cornell-editor-page.tsx"
  ]
}
