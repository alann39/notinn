                          "id": "gb5o9",
                          "name": "A",
                          "fill": "$foreground-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "No. Notinn lives in Telegram — open the bot and send your first message.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-body",
                          "fontSize": 15,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "A4PgJt",
                      "name": "Question",
                      "width": "fill_container",
                      "fill": "$surface-secondary",
                      "cornerRadius": 12,
                      "layout": "vertical",
                      "gap": 8,
                      "padding": 24,
                      "children": [
                        {
                          "type": "text",
                          "id": "a2BDb",
                          "name": "Q",
                          "fill": "$foreground-primary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "What can I send to Notinn?",
                          "fontFamily": "$font-body",
                          "fontSize": 16,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "T7899m",
                          "name": "A",
                          "fill": "$foreground-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Messy text, voice notes, forwarded messages, screenshots, PDFs, DOCX, TXT and Markdown.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-body",
                          "fontSize": 15,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "dO7Pw",
                      "name": "Question",
                      "width": "fill_container",
                      "fill": "$surface-secondary",
                      "cornerRadius": 12,
                      "layout": "vertical",
                      "gap": 8,
                      "padding": 24,
                      "children": [
                        {
                          "type": "text",
                          "id": "gTETW",
                          "name": "Q",
                          "fill": "$foreground-primary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "What happens to my files?",
                          "fontFamily": "$font-body",
                          "fontSize": 16,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "te9qK",
                          "name": "A",
                          "fill": "$foreground-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Media is processed in memory and never stored. Only the structured note is saved.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-body",
                          "fontSize": 15,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "xm6Jb",
                      "name": "Question",
                      "width": "fill_container",
                      "fill": "$surface-secondary",
                      "cornerRadius": 12,
                      "layout": "vertical",
                      "gap": 8,
                      "padding": 24,
                      "children": [
                        {
                          "type": "text",
                          "id": "g3kuHv",
                          "name": "Q",
                          "fill": "$foreground-primary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "How do I find notes later?",
                          "fontFamily": "$font-body",
                          "fontSize": 16,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "DhnQt",
                          "name": "A",
                          "fill": "$foreground-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Use /recent to list, /search for keywords, or /ask a question with evidence-only answers.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-body",
                          "fontSize": 15,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "xLRbr",
                      "name": "Question",
                      "width": "fill_container",
                      "fill": "$surface-secondary",
                      "cornerRadius": 12,
                      "layout": "vertical",
                      "gap": 8,
                      "padding": 24,
                      "children": [
                        {
                          "type": "text",
                          "id": "ZfQRA",
                          "name": "Q",
                          "fill": "$foreground-primary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Is it really free?",
                          "fontFamily": "$font-body",
                          "fontSize": 16,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "hHZzn",
                          "name": "A",
                          "fill": "$foreground-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Yes, during closed alpha. Pricing will be announced before anything changes.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-body",
                          "fontSize": 15,
                          "fontWeight": "normal"
                        }
                      ]
