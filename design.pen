            {
              "type": "text",
              "id": "o19ow3",
              "fill": "#545454ff",
              "content": "https://21st.dev/community/components?q=HOW&preview=%2F%40chamaac%2Fcomponents%2Fhow-it-works",
              "fontFamily": "Geist",
