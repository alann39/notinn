# Notinn — environment variables
#
# Names and descriptions only. No values, no examples that look like real values,
# no placeholders that could be pasted by mistake. Copy this file to `.env` and
# fill it in; `.env` is git-ignored and must never be committed.
#
# Verify a filled-in file with:  deno task verify-env
#
# --- Application (read by the Edge Function) --------------------------------

# The Supabase project URL. Public; safe to appear in client code.
SUPABASE_URL=

# The service-role key. SERVER-SIDE ONLY.
#
# This key bypasses row level security. It is read by the Edge Function and by
# nothing else. It must never reach the Telegram client, a browser, a log line,
# or a commit. `verify-env` reports its role and length but never its value.
SUPABASE_SERVICE_ROLE_KEY=

# The secret token registered with Telegram when the webhook was set.
#
# Telegram echoes it in the X-Telegram-Bot-Api-Secret-Token header on every
# delivery, and the webhook refuses any request that does not carry it. That
# header is the only thing standing between the endpoint and the public
# internet, so this value is a credential, not a configuration.
#
# Must match [A-Za-z0-9_-]{1,256}: Telegram rejects anything else, so an invalid
# value fails at registration rather than at the first delivery. Generate one
# with `openssl rand -hex 32`. Rotate it by setting a new value here, deploying,
# and re-registering the webhook — in that order, so there is no window where
# deliveries are refused.
TELEGRAM_WEBHOOK_SECRET=

# Shared only by trusted schedulers/operators and the process-job Edge Function.
# Use at least 32 random characters. Never send it from a browser or Telegram.
INTERNAL_WORKER_SECRET=

# Which environment this is: local | development | staging | production.
#
# Read to decide how much detail a log line carries, and used by the test
# tooling as a hard stop: NOTINN_ENV=production makes the integration and
# cleanup scripts refuse to run at all, because both write and delete rows.
NOTINN_ENV=local

# Log verbosity: debug | info | warn | error. Defaults to info.
#
# `debug` adds no user content — see docs/DATA_PRIVACY.md. There is no level at
# which message text, transcripts, extracted documents, tokens, file URLs or
# signed URLs are written.
NOTINN_LOG_LEVEL=info

# --- Local tooling (read by scripts/, never by the Edge Function) -----------

# The bot token from BotFather. Used server-side by the webhook, worker and
# operator scripts. It is never sent to Gemini or a client.
TELEGRAM_BOT_TOKEN=

# The public URL Telegram should deliver to. Used by `webhook:set` and `smoke`.
TELEGRAM_WEBHOOK_URL=

# --- Test tooling (read only by the test suites) ----------------------------
#
# These names deliberately do not appear anywhere in the application, so a test
# run cannot inherit the credentials that happen to be exported for the Edge
# Function. Pointing these at production means typing a production URL into a
# variable called "test".
#
# Leave them unset and the integration and e2e suites are *ignored* rather than
# failed — the unit, contract and security suites run anywhere.

# The project the integration suite writes to. Use a local or dedicated
# development project. Never production.
NOTINN_TEST_SUPABASE_URL=

# The service-role key for that same project.
NOTINN_TEST_SERVICE_ROLE_KEY=

# A publishable (anon) key for that same project, used only by the two tests
# that prove row level security denies a client role. Optional: without it those
# two checks are skipped rather than passed vacuously.
NOTINN_TEST_ANON_KEY=

# The deployed webhook endpoint and its secret, for the end-to-end suite.
# Setting these sends real HTTP requests to a real deployment.
NOTINN_TEST_WEBHOOK_URL=
NOTINN_TEST_WEBHOOK_SECRET=
